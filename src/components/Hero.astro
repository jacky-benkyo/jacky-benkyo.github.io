---
import { profile, stats } from '../data/profile';
---
<section id="top" class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="label status"><span class="led"></span> Open to robotics engineering roles · DE / EU</p>
      <h1>
        {profile.name}
        <span class="nick">({profile.nickname})</span>
      </h1>
      <p class="role mono">&gt; {profile.title}<span class="caret">_</span></p>
      <p class="tagline">{profile.tagline}</p>
      <div class="cta">
        <a class="btn primary" href="#projects">See projects</a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a class="btn" href="#contact">Contact</a>
      </div>
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dt class="mono">{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="frame">
      <span class="corner tl"></span><span class="corner tr"></span>
      <span class="corner bl"></span><span class="corner br"></span>
      <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="480" height="640" />
      <figcaption class="mono">
        <span>LOC</span> {profile.location}
        <span class="sep">|</span>
        <span>ROS_DISTRO</span> humble
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding: 72px 0 96px; }
  .grid { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 64px; align-items: center; }
  .status { display: inline-flex; align-items: center; gap: 10px; color: var(--signal); }
  .led { width: 8px; height: 8px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 10px var(--signal); }
  h1 { font-size: clamp(42px, 6.5vw, 80px); line-height: 1; letter-spacing: -0.035em; margin: 18px 0 14px; }
  .nick { color: var(--muted); font-weight: 500; }
  .role { color: var(--accent); font-size: clamp(15px, 2vw, 19px); margin: 0 0 20px; }
  .caret { animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .tagline { font-size: clamp(18px, 2.2vw, 22px); color: var(--muted); max-width: 34ch; margin: 0 0 32px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 48px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin: 0; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .stats div { background: var(--panel); padding: 16px; }
  .stats dt { font-size: 26px; font-weight: 500; color: var(--text); }
  .stats dd { margin: 4px 0 0; font-size: 13px; line-height: 1.35; color: var(--muted); }

  .frame { position: relative; margin: 0; padding: 14px; }
  .frame img { border-radius: 10px; aspect-ratio: 3 / 4; object-fit: cover; width: 100%; height: auto; filter: saturate(0.95); box-shadow: var(--shadow); }
  .corner { position: absolute; width: 26px; height: 26px; border: 2px solid var(--accent); }
  .tl { top: 0; left: 0; border-right: 0; border-bottom: 0; }
  .tr { top: 0; right: 0; border-left: 0; border-bottom: 0; }
  .bl { bottom: 0; left: 0; border-right: 0; border-top: 0; }
  .br { bottom: 0; right: 0; border-left: 0; border-top: 0; }
  figcaption {
    position: absolute; left: 28px; right: 28px; bottom: 28px;
    font-size: 11px; color: #e6edf3; padding: 8px 12px; border-radius: 8px;
    background: rgba(11, 15, 20, 0.72); backdrop-filter: blur(6px);
  }
  figcaption span { color: #ff8a1f; }
  figcaption .sep { color: #556; margin: 0 6px; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 40px; }
    .frame { max-width: 360px; order: -1; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
