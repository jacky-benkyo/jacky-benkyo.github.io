---
import { profile } from '../data/profile';

const links = [
  { href: '#about', label: 'About' },
  { href: '#stack', label: 'Stack' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="brand">
      <span class="dot"></span>
      <span>{profile.nickname} Chow</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn primary cv" href={profile.resume} download>CV ↓</a>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; text-decoration: none; letter-spacing: -0.01em; }
  .dot {
    width: 10px; height: 10px; border-radius: 50%; background: var(--signal);
    box-shadow: 0 0 0 4px var(--signal-soft);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px transparent; } }
  ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  ul a {
    display: block; padding: 8px 12px; border-radius: 8px;
    font-size: 14px; color: var(--muted); text-decoration: none;
  }
  ul a:hover { color: var(--text); background: var(--bg-2); }
  .cv { padding: 8px 14px; font-size: 14px; }
  @media (max-width: 860px) { nav { display: none; } }
</style>
